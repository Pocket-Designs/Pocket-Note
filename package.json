{
  "name": "pocket-note",
  "version": "1.0.0",
  "description": "Pocket-Note \u2013 notebook app with canvas pages, tables, encryption and folder sync",
  "main": "main.js",
  "author": {
    "name": "project-tech-me",
    "email": "project-tech-me@protonmail.com"
  },
  "license": "MIT",
  "scripts": {
    "prepare-app": "node scripts/copy-app.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder",
    "dist:win": "npm run prepare-app && electron-builder --win",
    "dist:linux": "npm run prepare-app && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.pocket-note.desktop",
    "productName": "Pocket-Note",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "msi",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "LICENSE"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "project-tech-me <project-tech-me@protonmail.com>"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false
    },
    "artifactName": "Pocket-Note-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "copyright": "Copyright \u00a9 2026 project-tech-me",
    "publish": null
  },
  "homepage": "https://github.com/Projects-me-design",
  "repository": {
    "type": "git",
    "url": "https://github.com/Projects-me-design/PocketNote.git"
  }
}